#!/usr/bin/env php
<?php

declare(strict_types=1);

use Jkudish\DocumentExtraction\Dev\PrWorkflow\NativeCommandRunner;
use Jkudish\DocumentExtraction\Dev\PrWorkflow\CliArguments;
use Jkudish\DocumentExtraction\Dev\PrWorkflow\Workflow;
use Jkudish\DocumentExtraction\Dev\PrWorkflow\WorkflowException;

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

try {
    $command = CliArguments::parse(array_slice($argv, 1));
    $operation = $command['operation'];
    $options = $command['options'];
    $workflow = new Workflow($root, new NativeCommandRunner($root));

    if ($operation === 'analyse') {
        $workflow->analyse();
        exit(0);
    }

    if ($operation === 'check') {
        $result = $workflow->check($options['base'] ?? 'main');
        fwrite(STDOUT, "Verified exact SHA: {$result['sha']}\nPrivate receipt: {$result['receiptPath']}\n");
        exit(0);
    }

    if ($operation === 'signoff') {
        $sha = $workflow->signoff($options['approved-sha']);
        fwrite(STDOUT, "Signed off and read back exact SHA: {$sha}\n");
        exit(0);
    }

    fwrite(STDERR, "Usage: scripts/pr-workflow analyse | check [--base BRANCH] | signoff --approved-sha FULL_SHA\n");
    exit(2);
} catch (WorkflowException $exception) {
    fwrite(STDERR, 'PR workflow refused: '.$exception->getMessage()."\n");
    exit(1);
}
