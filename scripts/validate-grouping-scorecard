#!/usr/bin/env php
<?php

declare(strict_types=1);

use Jkudish\DocumentExtraction\Dev\GroupingScorecardValidator;

require dirname(__DIR__).'/vendor/autoload.php';

$arguments = $_SERVER['argv'] ?? null;

if (! is_array($arguments) || count($arguments) !== 2 || ! is_string($arguments[1])) {
    fwrite(STDERR, "Usage: php scripts/validate-grouping-scorecard <run-directory>\n");

    exit(2);
}

try {
    $summary = (new GroupingScorecardValidator)->validate($arguments[1]);

    printf(
        "Validated offline grouping scorecard: %d trials, %d fixtures, %d pages, %d native attempts, %d scorer results.\n",
        $summary['trials'],
        $summary['fixtures'],
        $summary['pages'],
        $summary['attempts'],
        $summary['scorer_results'],
    );
} catch (Throwable $exception) {
    fwrite(STDERR, $exception->getMessage()."\n");

    exit(1);
}
