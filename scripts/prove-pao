#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
php_bin="${PHP_BINARY:-php}"
proof_test="$root/tests/PaoFailureProof.php"
success_output="$(mktemp)"
failure_output="$(mktemp)"

cleanup() {
    rm -f "$proof_test" "$success_output" "$failure_output"
}

trap cleanup EXIT

PAO_FORCE=1 "$php_bin" "$root/vendor/bin/pest" --no-tia --colors=never >"$success_output" 2>&1

if ! grep -Eq '"result"[[:space:]]*:[[:space:]]*"passed"' "$success_output"; then
    cat "$success_output" >&2
    echo "PAO did not emit a passing optimized result." >&2
    exit 1
fi

cat >"$proof_test" <<'PHP'
<?php

declare(strict_types=1);

it('proves PAO preserves a Pest failure', function (): void {
    expect('actual')->toBe('expected');
});
PHP

set +e
PAO_FORCE=1 "$php_bin" "$root/vendor/bin/pest" "$proof_test" --no-tia --colors=never >"$failure_output" 2>&1
failure_status=$?
set -e

if [[ "$failure_status" -eq 0 ]]; then
    cat "$failure_output" >&2
    echo "PAO changed a failing Pest process into success." >&2
    exit 1
fi

if ! grep -Eq '"result"[[:space:]]*:[[:space:]]*"failed"' "$failure_output"; then
    cat "$failure_output" >&2
    echo "PAO did not preserve the failing result in its optimized output." >&2
    exit 1
fi

echo "PAO proof passed: success exit=0; intentional Pest failure exit=$failure_status with result=failed."
