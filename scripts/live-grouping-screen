#!/usr/bin/env php
<?php

declare(strict_types=1);

use Jkudish\DocumentExtraction\Dev\LiveGroupingScreen;
use Jkudish\DocumentExtraction\Dev\PrWorkflow\NativeCommandRunner;
use Jkudish\DocumentExtraction\Tests\Support\LiveGroupingModels;

$root = dirname(__DIR__);
require $root.'/vendor/autoload.php';

try {
    $arguments = array_slice($argv, 1);
    $stageArguments = array_values(array_filter(
        $arguments,
        static fn (string $argument): bool => str_starts_with($argument, '--stage='),
    ));

    if (count($stageArguments) !== 1) {
        throw new RuntimeException('Select exactly one approved stage with --stage=development-repeats or --stage=frozen-holdout.');
    }

    $stage = substr($stageArguments[0], strlen('--stage='));
    LiveGroupingModels::stage($stage);
    $arguments = array_values(array_filter(
        $arguments,
        static fn (string $argument): bool => ! str_starts_with($argument, '--stage='),
    ));
    $environment = getenv();
    $environment = is_array($environment) ? $environment : [];
    $screen = new LiveGroupingScreen(
        $root,
        new NativeCommandRunner($root),
        stage: $stage,
    );
    $result = $screen->execute($arguments, $environment);
    fwrite(STDOUT, $result['output'].PHP_EOL);

    foreach ($result['runs'] as $run) {
        fwrite(STDOUT, sprintf(
            "%s on %s (repeat %d) @ %s: %s, $%s (%s); scorecard %s\n",
            $run['model'],
            $run['fixture'],
            $run['repetition'],
            $run['endpoint'],
            $run['status'],
            $run['cost_usd'],
            $run['cost_source'],
            $run['scorecard'],
        ));
    }

    exit(0);
} catch (Throwable $exception) {
    fwrite(STDERR, 'Live grouping screen refused: '.$exception->getMessage().PHP_EOL);
    exit(1);
}
