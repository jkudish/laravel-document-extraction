#!/usr/bin/env bash

set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
sudo_cmd=()
download_directory="$(mktemp -d)"
chmod 700 "$download_directory"

cleanup() {
    rm -rf "$download_directory"
}

trap cleanup EXIT

cd "$root"

if [[ "$(id -u)" -ne 0 ]]; then
    sudo_cmd=(sudo)
fi

packages=(
    ca-certificates curl git unzip poppler-utils
    php8.4-cli php8.4-common php8.4-mbstring php8.4-xml php8.4-curl php8.4-zip
    php8.4-sqlite3 php8.4-bcmath php8.4-intl php8.4-imagick php8.4-pcov
    php8.5-cli php8.5-common php8.5-mbstring php8.5-xml php8.5-curl php8.5-zip
    php8.5-sqlite3 php8.5-bcmath php8.5-intl php8.5-imagick php8.5-pcov
)

if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
    echo "Installing the signed Debian Sury PHP repository..."
    "${sudo_cmd[@]}" apt-get update
    "${sudo_cmd[@]}" apt-get install -y ca-certificates curl lsb-release
    curl --fail --silent --show-error --location \
        https://packages.sury.org/debsuryorg-archive-keyring.deb \
        --output "$download_directory/debsuryorg-archive-keyring.deb"
    "${sudo_cmd[@]}" dpkg -i "$download_directory/debsuryorg-archive-keyring.deb"
fi

source_line="deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main"

if [[ ! -f /etc/apt/sources.list.d/php.list ]] || ! grep -Fqx "$source_line" /etc/apt/sources.list.d/php.list; then
    printf '%s\n' "$source_line" | "${sudo_cmd[@]}" tee /etc/apt/sources.list.d/php.list >/dev/null
fi

missing_packages=()

for package in "${packages[@]}"; do
    if ! dpkg-query --show --showformat='${db:Status-Status}' "$package" 2>/dev/null | grep -Fqx installed; then
        missing_packages+=("$package")
    fi
done

if (( ${#missing_packages[@]} > 0 )); then
    echo "Installing PHP and native document dependencies..."
    "${sudo_cmd[@]}" apt-get update
    "${sudo_cmd[@]}" apt-get install -y "${missing_packages[@]}"
fi

"${sudo_cmd[@]}" update-alternatives --set php /usr/bin/php8.5 >/dev/null

if ! command -v composer >/dev/null 2>&1; then
    echo "Installing Composer with its published SHA-384 signature..."
    expected_signature="$(curl --fail --silent --show-error https://composer.github.io/installer.sig)"
    curl --fail --silent --show-error https://getcomposer.org/installer --output "$download_directory/composer-setup.php"
    actual_signature="$(php8.5 -r 'echo hash_file("sha384", $argv[1]);' "$download_directory/composer-setup.php")"

    if [[ "$expected_signature" != "$actual_signature" ]]; then
        echo "Composer installer signature mismatch." >&2
        exit 1
    fi

    "${sudo_cmd[@]}" php8.5 "$download_directory/composer-setup.php" --quiet --install-dir=/usr/local/bin --filename=composer
fi

echo "Installing locked Composer dependencies..."
php8.5 "$(command -v composer)" install --no-interaction --prefer-dist --no-progress

echo "Setup complete: $(php8.4 -r 'echo PHP_VERSION;') / $(php8.5 -r 'echo PHP_VERSION;'), $(composer --version --no-ansi 2>/dev/null | head -n 1)"
