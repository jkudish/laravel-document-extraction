#!/usr/bin/env bash

set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# PHP must not inherit provider credentials even during readiness checks.
if [[ "${LDE_RESUME_ISOLATED:-}" != 1 ]]; then
    exec env -i HOME=/nonexistent PATH=/usr/local/bin:/usr/bin:/bin \
        LDE_RESUME_ISOLATED=1 /bin/bash "$0" "$@"
fi

for command in php8.4 php8.5 composer pdfimages pdfinfo pdftoppm pdftotext; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Missing $command; run .agents/setup." >&2
        exit 1
    fi
done

for php in php8.4 php8.5; do
    if ! "$php" -r 'exit(extension_loaded("imagick") && extension_loaded("pcov") ? 0 : 1);'; then
        echo "$php requires both Imagick and PCOV; run .agents/setup." >&2
        exit 1
    fi
done

if [[ ! -f "$root/vendor/autoload.php" ]]; then
    echo "Composer dependencies are absent; run .agents/setup." >&2
    exit 1
fi

echo "Document extraction development runtime is ready."
