<?php

declare(strict_types=1);

namespace PortableConsumer\Tests;

use Illuminate\Contracts\JsonSchema\JsonSchema;
use Jkudish\DocumentExtraction\AI\InlineSchemaAgent;
use Jkudish\DocumentExtraction\DocumentExtraction;
use Jkudish\DocumentExtraction\Facades\Extraction;
use Jkudish\DocumentExtraction\Results\CallRecord;
use Jkudish\DocumentExtraction\Results\PageResult;
use Laravel\Ai\Attributes\Model;
use Laravel\Ai\Attributes\Provider;
use Laravel\Ai\Contracts\Agent;
use Laravel\Ai\Contracts\HasProviderOptions;
use Laravel\Ai\Contracts\HasStructuredOutput;
use Laravel\Ai\Enums\Lab;
use Laravel\Ai\Promptable;
use ReflectionClass;
use RuntimeException;

#[Provider('portable-openrouter')]
#[Model('synthetic-shipping-model')]
final class ShippingManifestAgent implements Agent, HasProviderOptions, HasStructuredOutput
{
    use Promptable;

    /** @var list<string> */
    public static array $optionSelectors = [];

    public function instructions(): string
    {
        return 'Extract only shipping-manifest facts present in the source.';
    }

    /** @return array<string, mixed> */
    public function schema(JsonSchema $schema): array
    {
        return [
            'manifest_number' => $schema->string()->pattern('^MAN-[0-9]{4}$')->required(),
            'ship_date' => $schema->string()->pattern('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')->required(),
            'packages' => $schema->array()->items($schema->object([
                'handling_unit' => $schema->string()->enum(['carton', 'pallet'])->required(),
                'quantity' => $schema->integer()->min(1)->required(),
                'weight_kg' => $schema->string()->pattern('^(?:0|[1-9][0-9]*)\.[0-9]{3}$')->required(),
            ]))->required(),
        ];
    }

    /** @return array<string, mixed> */
    public function providerOptions(Lab|string $provider): array
    {
        self::$optionSelectors[] = $provider instanceof Lab ? $provider->value : $provider;

        return ['provider' => ['data_collection' => 'deny', 'zdr' => true]];
    }
}

it('loads the package exclusively from the clean consumer installation', function (): void {
    $installPath = dirname((string) (new ReflectionClass(DocumentExtraction::class))->getFileName(), 2);
    $sourceRoot = getenv('LDE_SOURCE_ROOT');

    expect($sourceRoot)->toBeString()
        ->and(realpath($installPath))->toBe(realpath(dirname(__DIR__).'/vendor/jkudish/laravel-document-extraction'))
        ->and(realpath($installPath))->not->toBe(realpath((string) $sourceRoot));
});

it('proves jMail can consume direct and partial text without surrendering stream ownership', function (): void {
    $stream = fopen('php://temp', 'w+');

    if ($stream === false) {
        throw new RuntimeException('Unable to create the jMail consumer stream.');
    }

    fwrite($stream, "Portable contract\r\nFirst line.\r\nSecond line.");
    rewind($stream);

    try {
        $direct = Extraction::fromStream($stream, mimeType: 'text/plain')
            ->withoutAi()
            ->text();

        expect($direct->text)->toBe("Portable contract\nFirst line.\nSecond line.")
            ->and($direct->complete())->toBeTrue()
            ->and($direct->calls)->toBeEmpty()
            ->and(is_resource($stream))->toBeTrue();

        rewind($stream);
        expect(stream_get_contents($stream))->toContain('Portable contract');
    } finally {
        fclose($stream);
    }

    $partial = Extraction::fromPath(__DIR__.'/Fixtures/mixed.pdf')
        ->withoutAi()
        ->text();
    $page = $partial->pages->first();
    assert($page instanceof PageResult);

    expect($partial->text)->toBeString()
        ->and($partial->text)->not->toBe('')
        ->and($partial->complete())->toBeFalse()
        ->and($page->page)->toBe(1)
        ->and($page->complete())->toBeFalse()
        ->and($page->error?->code)->toBe('ocr_required')
        ->and($partial->errors->first()?->pages)->toBe([1]);
});

it('proves ReceiptFox can preserve validated exact decimal strings', function (): void {
    InlineSchemaAgent::fake([json_encode([
        'receipt_number' => 'RF-1042',
        'currency' => 'CAD',
        'purchased_on' => '2026-09-08',
        'subtotal' => '10.00',
        'tax' => '1.30',
        'total' => '11.30',
    ], JSON_THROW_ON_ERROR)])->preventStrayPrompts();

    $result = Extraction::fromString('Synthetic ReceiptFox receipt.', 'text/plain')
        ->instructions('Extract source facts; do not calculate or confirm accounting treatment.')
        ->schema(fn (JsonSchema $schema): array => [
            'receipt_number' => $schema->string()->pattern('^RF-[0-9]{4}$')->required(),
            'currency' => $schema->string()->enum(['CAD', 'USD'])->required(),
            'purchased_on' => $schema->string()->pattern('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')->required(),
            'subtotal' => $schema->string()->pattern('^(?:0|[1-9][0-9]*)\.[0-9]{2}$')->required(),
            'tax' => $schema->string()->pattern('^(?:0|[1-9][0-9]*)\.[0-9]{2}$')->required(),
            'total' => $schema->string()->pattern('^(?:0|[1-9][0-9]*)\.[0-9]{2}$')->required(),
        ])
        ->extract();
    $call = $result->calls->first();
    assert($call instanceof CallRecord);

    expect($result->data)->toMatchArray([
        'currency' => 'CAD',
        'subtotal' => '10.00',
        'tax' => '1.30',
        'total' => '11.30',
    ])->and($result->complete())->toBeTrue()
        ->and($call->evidenceOrigin->value)->toBe('simulated')
        ->and($result->cost->complete)->toBeFalse()
        ->and($result->cost->unpricedCalls->all())->toBe([$call->reference()]);
});

it('rejects ReceiptFox values outside its exact consumer schema before data access', function (): void {
    InlineSchemaAgent::fake(['{"receipt_number":"RF-1042","currency":"CAD","total":"11.3"}'])
        ->preventStrayPrompts();

    $result = Extraction::fromString('Synthetic ReceiptFox receipt.', 'text/plain')
        ->schema(fn (JsonSchema $schema): array => [
            'receipt_number' => $schema->string()->pattern('^RF-[0-9]{4}$')->required(),
            'currency' => $schema->string()->enum(['CAD', 'USD'])->required(),
            'total' => $schema->string()->pattern('^(?:0|[1-9][0-9]*)\.[0-9]{2}$')->required(),
        ])
        ->extract();

    expect($result->complete())->toBeFalse()
        ->and($result->data)->toBeNull()
        ->and($result->errors->first()?->code)->toBe('invalid_output')
        ->and($result->calls->first()?->outcome)->toBe('invalid_output');
});

it('proves a third consumer can use a reusable nested shipping-manifest agent', function (): void {
    config()->set('ai.providers.portable-openrouter', [
        'driver' => 'openrouter',
        'key' => 'offline-consumer-proof',
    ]);
    config()->set('extraction.provider', null);
    config()->set('extraction.model', null);
    ShippingManifestAgent::$optionSelectors = [];
    ShippingManifestAgent::fake([json_encode([
        'manifest_number' => 'MAN-2048',
        'ship_date' => '2026-09-08',
        'packages' => [
            ['handling_unit' => 'pallet', 'quantity' => 2, 'weight_kg' => '315.750'],
            ['handling_unit' => 'carton', 'quantity' => 8, 'weight_kg' => '42.000'],
        ],
    ], JSON_THROW_ON_ERROR)])->preventStrayPrompts();

    $result = Extraction::fromString('Synthetic shipping manifest.', 'text/plain')
        ->using(new ShippingManifestAgent)
        ->extract();

    expect($result->complete())->toBeTrue()
        ->and($result->data['manifest_number'] ?? null)->toBe('MAN-2048')
        ->and($result->data['packages'][0]['quantity'] ?? null)->toBe(2)
        ->and(ShippingManifestAgent::$optionSelectors)->toBe(['openrouter'])
        ->and($result->calls->first()?->requestedProvider)->toBe('portable-openrouter')
        ->and($result->calls->first()?->evidenceOrigin->value)->toBe('simulated');
});
